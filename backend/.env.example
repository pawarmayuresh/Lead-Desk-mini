# ============================================================
# LeadDesk Mini Pro — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Neon PostgreSQL connection string (includes ?sslmode=require)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── JWT ──────────────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_THIS_TO_A_64_CHAR_RANDOM_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ───────────────────────────────────────────────
# Values: development | production
APP_ENV=production

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://leaddesk.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ── Cookie Security ───────────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=true
# lax works for most setups; use strict if frontend and backend are same domain
COOKIE_SAMESITE=lax
# Leave empty to use current domain; set explicitly for subdomain setups
COOKIE_DOMAIN=
